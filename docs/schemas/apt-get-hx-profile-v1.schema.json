{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apt-get-hx-profile-v1.schema.json",
  "title": "APT-GET-HX cycle profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model", "kernel", "shape", "candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "model": {"type": "string", "minLength": 1},
    "kernel": {"type": "string", "minLength": 1},
    "shape": {"type": "string", "minLength": 1},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "legal_distances": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "coverage_factor": {"type": "number", "exclusiveMinimum": 0},
        "min_peak_separation": {"type": "number", "minimum": 0}
      }
    },
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "histogram": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cycles", "count"],
        "properties": {
          "cycles": {"type": "integer", "minimum": 1},
          "count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loop_id", "trip_count", "iteration_cycle_histogram"],
      "properties": {
        "loop_id": {"type": "string", "minLength": 1},
        "trip_count": {"type": "integer", "minimum": 1},
        "iteration_cycle_histogram": {"$ref": "#/$defs/histogram"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "inner_loop",
        "row_bytes",
        "rows",
        "stride",
        "page_split_count"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "address_source": {"enum": ["manual", "prefetch-kernel-hx"]},
        "memory_bound": {"type": "boolean"},
        "inner_loop": {"$ref": "#/$defs/loop"},
        "outer_loop": {"$ref": "#/$defs/loop"},
        "row_bytes": {"type": "integer", "minimum": 1},
        "rows": {"type": "integer", "minimum": 1},
        "stride": {"type": "integer", "minimum": 1},
        "page_split_count": {"type": "integer", "minimum": 0},
        "max_page_splits": {"type": "integer", "minimum": 0},
        "max_command_bytes": {"type": "integer", "minimum": 1},
        "residency_budget_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
