diff --git a/llvm/lib/Target/Hexagon/HexagonFrameLowering.cpp b/llvm/lib/Target/Hexagon/HexagonFrameLowering.cpp
index b3c61e1829bf..f5db0265c8fc 100644
--- a/llvm/lib/Target/Hexagon/HexagonFrameLowering.cpp
+++ b/llvm/lib/Target/Hexagon/HexagonFrameLowering.cpp
@@ -750,6 +750,18 @@ void HexagonFrameLowering::insertPrologueInBlock(MachineBasicBlock &MBB,
       .addReg(SP)
       .addImm(-int(NumBytes));
   }
+
+  // PS_aligna is selected before prologue/epilogue insertion. Scheduling can
+  // otherwise leave an aligned-frame access before the pseudo, while this
+  // routine subsequently inserts allocframe at the start of the block. Move
+  // the pseudo back to the prologue boundary so the final order is:
+  // allocframe, stack alignment, AP definition, AP uses.
+  if (MachineInstr *AI =
+          const_cast<MachineInstr *>(getAlignaInstr(MF))) {
+    MachineBasicBlock *AlignB = AI->getParent();
+    MBB.splice(InsertPt, AlignB, AI->getIterator());
+    AI->setFlag(MachineInstr::FrameSetup);
+  }
 }
 
