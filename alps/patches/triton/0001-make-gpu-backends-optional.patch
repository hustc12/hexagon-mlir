+def get_in_tree_backends():
+    """Return the requested built-in backends.
+
+    Upstream Triton builds NVIDIA and AMD by default. Downstream CPU/NPU-only
+    plugins can set TRITON_IN_TREE_BACKENDS to an empty string and avoid
+    requiring LLVM's NVPTX and AMDGPU targets.
+    """
+    requested = os.getenv("TRITON_IN_TREE_BACKENDS", "nvidia;amd")
+    return [name for name in requested.replace(",", ";").split(";") if name]
+
+
+backends = [*BackendInstaller.copy(get_in_tree_backends()), *BackendInstaller.copy_externals()]
 
 
